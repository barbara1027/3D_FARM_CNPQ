NODE_ENV=development
PORT=3333

# MySQL 8.0.16+. Todos os valores são obrigatórios; não há credenciais padrão.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=3d_farm_app
DB_PASSWORD=change_me
DB_NAME=3d_farm

# Proteções adicionais do seed de desenvolvimento.
# Para executar db:seed, copie explicitamente DB_NAME para DB_SEED_CONFIRM.
DB_SEED_CONFIRM=
DEV_SEED_PASSWORD=change_this_local_password

HORAS_OPERADOR_DIA=4
JORNADA_INICIO_HORA=8
JORNADA_HORAS_DIA=8
ETA_BUFFER_PERCENTUAL=0.20
FATOR_INTERFERENCIA_PRIORIDADE=0.10
SETUP_MEDIO_FARM_HORAS=0.30

# Tempo máximo para confirmar fisicamente que um início comum chegou a
# "Imprimindo". O fluxo CFS real permanece desabilitado enquanto o protocolo
# LAN não tiver sido validado separadamente na K2 Pro e na Creality Hi.
PRINTER_START_CONFIRM_TIMEOUT_MS=15000
