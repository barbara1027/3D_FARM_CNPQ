{
  "name": "3d-farm-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "ts-node src/database/commands/init.ts",
    "db:verify": "ts-node src/database/commands/verify.ts",
    "db:seed": "ts-node src/seed.ts",
    "test": "node --require ts-node/register --require ./src/test/setup.ts --test --test-concurrency=1 src/modules/impressoras/impressoras.service.test.ts src/modules/pedidos/pedidos.repository.test.ts src/modules/pedidos/pedidos.service.test.ts src/modules/fila/filaOtimizacao.service.test.ts src/modules/fila/pedidoImpressora.repository.test.ts src/modules/impressoras/comunicacao/cfs-print.adapter.test.ts src/modules/impressoras/comunicacao/gcode-logical-filament.parser.test.ts src/modules/impressoras/comunicacao/orquestrador.service.test.ts",
    "test:mysql-integration": "node --require ts-node/register --require ./src/test/setup.ts --test --test-concurrency=1 src/modules/fila/pedidoImpressora.repository.integration.test.ts"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "form-data": "^4.0.4",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "stripe": "^22.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
